# Copy to .env (which git ignores) and point these at your local data.
# dsdk's tome curator reads them; see docs/getting-data.md.

# The folder you downloaded the CSDS data into.
PURESKILLGG_TOME_DS_COLLECTION_PATH=/path/to/csds
# The folder your tomes are built in.
PURESKILLGG_TOME_COLLECTION_PATH=/path/to/tomes
PURESKILLGG_TOME_DS_TYPE=csds
PURESKILLGG_TOME_DEFAULT_HEADER_NAME=header
